--- posix-c clock reads — libc `clock_gettime` via `ffi.call`.
---
--- @details
--- Implements the `posix` contract's clock surface directly (folded
--- from `lib-time-c`): `now_ms`, `instant_ns`, `elapsed_ns` and
--- `epoch`, plus the legacy `now` alias kept for existing consumers.
--- `ffi`, `error` and `type` are host modules reached by qualified
--- call with no import line (the fs.hnl convention); `read_ns` is the
--- raw `clock_gettime` reader in `clock_gettime.hnl`.

from "./clock_gettime" import { read_ns }

-- clock_gettime(2) clock ids (linux/generic values).
CLOCK_REALTIME := 0
CLOCK_MONOTONIC := 1

--- Wall-clock milliseconds since the Unix epoch (CLOCK_REALTIME).
--- @details
--- Wall-clock read; may go backwards under NTP slew, leap seconds or
--- manual changes. Use `instant_ns` for monotonic elapsed-time
--- measurement.
--- @returns {Nat - milliseconds since 1970-01-01 00:00:00 UTC}
-- TODO(n-dim): effect row
export now_ms: () ~[1]~> Nat := () ~> read_ns(CLOCK_REALTIME) / 1000000

--- Nanoseconds on a monotonic clock (CLOCK_MONOTONIC).
--- @returns {Nat - nanoseconds from a backend-chosen, unspecified epoch}
-- TODO(n-dim): effect row
export instant_ns: () ~[1]~> Nat := () ~> read_ns(CLOCK_MONOTONIC)

--- Nanoseconds elapsed since a previous `instant_ns` reading.
--- @details
--- Saturated at 0, so bogus or future `start` values do not produce
--- negative elapsed times.
--- @param {start} - a previous `instant_ns` reading
--- @returns {Nat - nanoseconds elapsed since `start`, saturated at 0}
-- TODO(n-dim): effect row
export elapsed_ns: Nat ~> Nat := (start) ~> do {
  now := read_ns(CLOCK_MONOTONIC)
  if now >= start { now - start } else { 0 }
}

--- Wall-clock seconds since the Unix epoch, fractional.
--- @returns {Number - seconds since 1970-01-01 00:00:00 UTC}
-- TODO(n-dim): effect row
export epoch: () ~[1]~> Number := () ~> now_ms() / 1000

--- Current wall-clock time as epoch milliseconds.
--- @returns {Number - milliseconds since the Unix epoch}
-- TODO(n-dim): effect row
export now: () ~[1]~> Number := () ~> now_ms()
